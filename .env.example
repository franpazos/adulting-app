# Copy to .env.local for local development. In production, set the same
# variable in Vercel → Project Settings → Environment Variables.
#
# Vite only exposes vars prefixed with VITE_ to the client bundle.

# Google OAuth Client ID — from Google Cloud Console → APIs & Services →
# Credentials → OAuth Client ID (Web application). Format:
# 123456789012-abcdefghijklmnop.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
